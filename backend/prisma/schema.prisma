generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id              BigInt          @id @unique(map: "id") @default(autoincrement())
  user_id         BigInt
  booking_date    DateTime        @default(now()) @db.DateTime(0)
  check_in_date   DateTime        @db.Date
  check_out_date  DateTime        @db.Date
  guest_count     Int
  special_request String          @db.Text
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @db.DateTime(0)
  user            user            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "booking_fk1")
  bookingdetail   bookingdetail[]
  checkinout      checkinout[]
  invoice         invoice[]
  serviceusage    serviceusage[]

  @@index([user_id], map: "booking_fk1")
}

model bookingdetail {
  booking_detail_id BigInt  @id @default(autoincrement())
  booking_id        BigInt
  room_id           BigInt
  price_per_night   Decimal @db.Decimal(12, 2)
  number_of_nights  Int
  subtotal          Decimal @db.Decimal(12, 2)
  note              String? @db.VarChar(255)
  booking           booking @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bookingdetail_fk1")
  room              room    @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bookingdetail_fk2")

  @@index([booking_id], map: "bookingdetail_fk1")
  @@index([room_id], map: "bookingdetail_fk2")
}

model checkinout {
  check_in_out_id BigInt   @id @default(autoincrement())
  booking_id      BigInt
  room_id         BigInt
  user_id         BigInt
  check_in_time   DateTime @db.DateTime(0)
  check_out_time  DateTime @db.DateTime(0)
  note            String   @db.VarChar(255)
  booking         booking  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "checkinout_fk1")
  room            room     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "checkinout_fk2")
  user            user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "checkinout_fk3")

  @@index([booking_id], map: "checkinout_fk1")
  @@index([room_id], map: "checkinout_fk2")
  @@index([user_id], map: "checkinout_fk3")
}

model invoice {
  id               BigInt          @id @default(autoincrement())
  booking_id       BigInt
  invoice_code     String          @unique(map: "invoice_code") @db.VarChar(20)
  room_amount      Decimal         @default(0.00) @db.Decimal(12, 2)
  issued_date      DateTime        @default(now()) @db.DateTime(0)
  service_amount   Decimal         @default(0.00) @db.Decimal(12, 2)
  surcharge_amount Decimal         @default(0.00) @db.Decimal(12, 2)
  discount_amount  Decimal         @default(0.00) @db.Decimal(12, 2)
  tax_amount       Decimal         @default(0.00) @db.Decimal(12, 2)
  total_amount     Decimal         @default(0.00) @db.Decimal(12, 2)
  note             String?         @db.VarChar(255)
  updated_at       DateTime        @default(now()) @db.DateTime(0)
  booking          booking         @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_fk1")
  invoicedetail    invoicedetail[]
  payment          payment[]

  @@index([booking_id], map: "invoice_fk1")
}

model invoicedetail {
  id           BigInt  @id @default(autoincrement())
  invoice_id   BigInt
  reference_id BigInt
  description  String? @db.VarChar(255)
  quantity     Int     @default(1)
  unit_price   Decimal @default(0.00) @db.Decimal(12, 2)
  amount       Decimal @default(0.00) @db.Decimal(12, 2)
  invoice      invoice @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoicedetail_fk1")

  @@index([invoice_id], map: "invoicedetail_fk1")
}

model payment {
  id         BigInt   @id @default(autoincrement())
  invoice_id BigInt
  user_id    BigInt
  amount     Decimal  @db.Decimal(12, 2)
  paid_at    DateTime @default(now()) @db.DateTime(0)
  invoice    invoice  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_fk1")
  user       user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_fk2")

  @@index([invoice_id], map: "payment_fk1")
  @@index([user_id], map: "payment_fk2")
}

model role {
  id          BigInt @id @default(autoincrement())
  role_name   String @db.VarChar(50)
  description String @db.VarChar(255)
  user        user[]
}

model room {
  id            BigInt          @id @default(autoincrement())
  room_number   String          @unique(map: "room_number") @db.VarChar(10)
  floor         Int
  description   String          @db.VarChar(255)
  image_url     String          @db.VarChar(255)
  type_id       BigInt
  bookingdetail bookingdetail[]
  checkinout    checkinout[]
  roomtype      roomtype        @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "room_fk5")

  @@index([type_id], map: "room_fk5")
}

model roomtype {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(50)
  price       Decimal @db.Decimal(12, 2)
  capacity    Int
  description String  @db.VarChar(255)
  room        room[]
}

model service {
  id           BigInt         @id @default(autoincrement())
  service_name String         @db.VarChar(100)
  description  String         @db.Text
  unit_price   Decimal        @db.Decimal(12, 2)
  unit         String         @db.VarChar(20)
  duration     Int
  created_at   DateTime       @default(now()) @db.DateTime(0)
  updated_at   DateTime       @default(now()) @db.DateTime(0)
  serviceusage serviceusage[]
}

model serviceusage {
  id         BigInt   @id @default(autoincrement())
  service_id BigInt
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  note       String?  @db.VarChar(255)
  used_at    DateTime @default(now()) @db.DateTime(0)
  booking_id BigInt
  service    service  @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "serviceusage_fk1")
  booking    booking  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "serviceusage_fk7")

  @@index([service_id], map: "serviceusage_fk1")
  @@index([booking_id], map: "serviceusage_fk7")
}

model user {
  id            BigInt       @id @default(autoincrement())
  email         String       @unique(map: "email") @db.VarChar(100)
  password_hash String       @db.VarChar(255)
  full_name     String       @db.VarChar(100)
  phone         String       @db.VarChar(20)
  created_at    DateTime     @default(now()) @db.DateTime(0)
  updated_at    DateTime     @default(now()) @db.DateTime(0)
  role_id       BigInt
  booking       booking[]
  checkinout    checkinout[]
  payment       payment[]
  role          role         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_fk7")

  @@index([role_id], map: "user_fk7")
}
