datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Thêm lại dòng này
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())

  @@map("users")
}